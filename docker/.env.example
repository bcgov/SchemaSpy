# Default environment for the SchemaSpy docker compose stack.
# Copy or edit in place - values here are example-only, non-secret defaults.

# -------------------------------------------------------------------------
# Which database SchemaSpy should document.
# Set DATABASE_TYPE/DATABASE_HOST to either the postgres, mysql, or mssql
# service below, then leave the matching *_USER/*_PASSWORD/*_DATABASE
# values in sync with that service's own settings further down.
# -------------------------------------------------------------------------

# --- Postgres target (default) -------------------------------------------
DATABASE_TYPE=pgsql
DATABASE_HOST=postgres
DATABASE_NAME=example
DATABASE_SCHEMA=public
DATABASE_USER=example
DATABASE_PASSWORD=example

# --- MySQL target ----------------------------------------------------------
# Uncomment these, and comment out the Postgres block above, to point
# SchemaSpy at the mysql service instead.
# DATABASE_TYPE=mysql
# DATABASE_HOST=mysql
# DATABASE_NAME=example
# DATABASE_SCHEMA=
# DATABASE_USER=example
# DATABASE_PASSWORD=example

# --- MSSQL target ------------------------------------------------------------
# Uncomment these, and comment out the Postgres block above, to point
# SchemaSpy at the mssql service instead. Uses the mssql-modern custom type
# (see ../conf/mssql-modern.properties) since the bundled `mssql` type targets
# the legacy "jdbc:microsoft:sqlserver://" driver. DATABASE_DRIVER is required
# too, since SchemaSpy's lib/<DATABASE_TYPE>-jdbc.jar naming convention doesn't
# apply to a custom type name.
# DATABASE_TYPE=mssql-modern
# DATABASE_HOST=mssql
# DATABASE_NAME=example
# DATABASE_SCHEMA=dbo
# DATABASE_USER=sa
# DATABASE_PASSWORD=Example_123
# DATABASE_DRIVER=lib/mssql-jdbc.jar

# Port SchemaSpy's generated site is exposed on (http://localhost:<port>)
SCHEMASPY_EXPOSED_PORT=8082

# -------------------------------------------------------------------------
# Postgres service settings
# -------------------------------------------------------------------------
POSTGRES_DATABASE=example
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_EXPOSED_PORT=5432

# -------------------------------------------------------------------------
# MySQL service settings
# -------------------------------------------------------------------------
MYSQL_DATABASE=example
MYSQL_USER=example
MYSQL_PASSWORD=example
MYSQL_ROOT_PASSWORD=example
MYSQL_EXPOSED_PORT=3306

# -------------------------------------------------------------------------
# MSSQL service settings
# -------------------------------------------------------------------------
# Must satisfy SQL Server's complexity policy (upper+lower+digit, 8+ chars).
MSSQL_SA_PASSWORD=Example_123
MSSQL_EXPOSED_PORT=1433
